# Optional defaults for the two SQL instances.
# Leave blank to enter them in the UI instead.
# Never commit a filled-in .env file.

LEFT_LABEL=SQL Instance A
LEFT_DRIVER=mssql
LEFT_HOST=sql-a.example.internal
LEFT_PORT=1433
LEFT_DATABASE=YourDatabase
LEFT_USERNAME=
LEFT_PASSWORD=
LEFT_TRUSTED_CONNECTION=false
LEFT_SCHEMA=dbo
LEFT_TABLE=TBLINISETTINGS

RIGHT_LABEL=SQL Instance B
RIGHT_DRIVER=mssql
RIGHT_HOST=sql-b.example.internal
RIGHT_PORT=1433
RIGHT_DATABASE=YourDatabase
RIGHT_USERNAME=
RIGHT_PASSWORD=
RIGHT_TRUSTED_CONNECTION=false
RIGHT_SCHEMA=dbo
RIGHT_TABLE=TBLINISETTINGS
